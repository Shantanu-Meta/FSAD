# ===========================================================================
#  Backend environment variables — PRODUCTION profile (application-prod.yml)
#  Copy this file to `.env` (or export these in your shell) and fill real values.
#  The DEV profile uses H2 in-memory and needs NONE of these.
#
#  Run in production:
#    mvn spring-boot:run -Dspring-boot.run.profiles=prod
# ===========================================================================

# ---- PostgreSQL (default) ----
DB_URL=jdbc:postgresql://localhost:5432/admissiondb
DB_DRIVER=org.postgresql.Driver
DB_DIALECT=org.hibernate.dialect.PostgreSQLDialect
DB_USERNAME=admission
DB_PASSWORD=change_me

# ---- MySQL (override the three above with these to switch, zero code changes) ----
# DB_URL=jdbc:mysql://localhost:3306/admissiondb
# DB_DRIVER=com.mysql.cj.jdbc.Driver
# DB_DIALECT=org.hibernate.dialect.MySQLDialect

# ---- Server ----
# SERVER_PORT=8080
