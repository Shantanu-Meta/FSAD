# ===========================================================================
#  Frontend environment variables (Vite)
#  Copy to `.env` to override. All keys MUST be prefixed with VITE_.
# ===========================================================================

# Base URL for API calls. In development this is left as "/api" so that the
# Vite dev-server proxy (see vite.config.js) forwards to the backend on :8080
# and the session cookie stays same-origin.
#
# For a production build served separately from the backend, point this at the
# deployed API, e.g. https://api.your-domain.com/api
VITE_API_BASE_URL=/api
